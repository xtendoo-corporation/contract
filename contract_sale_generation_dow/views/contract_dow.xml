<odoo>
    <!-- Vista de formulario -->
    <record id="contract_contract_form_view_recurring_sale_dow_form" model="ir.ui.view">
        <field name="name">contract.contract.form.recurring.sale.dow.form</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <!-- Agregar el campo dow_ids después del campo generation_type -->
            <xpath expr="//field[@name='generation_type']" position="after">
                <field
                    name="dow_ids"
                    widget="many2many_tags"
                    string="Days of the Week"
                />
            </xpath>

            <!-- Crear un botón para crear ventas, similar al de la otra vista -->
            <xpath expr="//button[@name='recurring_create_invoice']" position="before">
                <button
                    invisible="generation_type != 'sale'"
                    class="oe_link"
                    groups="base.group_no_one"
                    name="recurring_create_sale"
                    string="CREATE SALES"
                    type="object"
                />
            </xpath>

            <!-- Agregar un botón de estadísticas de ventas, similar al de la otra vista -->
            <xpath expr="//button[@name='action_show_invoices']" position="after">
                <button
                    invisible="generation_type != 'sale'"
                    class="oe_stat_button"
                    icon="fa-list"
                    name="action_show_sales"
                    type="object"
                >
                    <field name="sale_count" string="Sales Order" widget="statinfo" />
                </button>
            </xpath>
        </field>
    </record>
</odoo>
