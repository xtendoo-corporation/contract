<odoo>
    <!-- Vista de formulario -->
    <record id="contract_contract_form_view_recurring_sale_dow_form" model="ir.ui.view">
        <field name="name">contract.contract.form.recurring.sale.dow.form</field>
        <field name="model">contract.contract</field>
        <field name="inherit_id" ref="contract.contract_contract_form_view" />
        <field name="arch" type="xml">
            <!-- Agregar el campo dow_ids después del campo generation_type -->
            <xpath expr="//field[@name='generation_type']" position="after">
                <field
                    name="contract_dow_ids"
                    widget="many2many_tags"
                    string="Days of the Week"
                />
            </xpath>
        </field>
    </record>
</odoo>
